<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Swiftsay.Button.Base" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <style name="Widget.Swiftsay.Button.Primary" parent="Widget.Swiftsay.Button.Base">
        <item name="backgroundTint">@color/swiftsay_button_primary_bg</item>
        <item name="android:textColor">@color/swiftsay_button_primary_text</item>
        <item name="strokeColor">@color/swiftsay_button_primary_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/swiftsay_button_ripple</item>
    </style>

    <style name="Widget.Swiftsay.Button.Secondary" parent="Widget.Swiftsay.Button.Base">
        <item name="backgroundTint">@color/swiftsay_button_secondary_bg</item>
        <item name="android:textColor">@color/swiftsay_button_secondary_text</item>
        <item name="strokeColor">@color/swiftsay_button_secondary_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/swiftsay_button_ripple</item>
    </style>

    <style name="Widget.Swiftsay.Button.Danger" parent="Widget.Swiftsay.Button.Base">
        <item name="backgroundTint">@color/swiftsay_surface_variant</item>
        <item name="android:textColor">@color/swiftsay_error</item>
        <item name="strokeColor">@color/swiftsay_error</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/swiftsay_button_ripple</item>
    </style>
</resources>
